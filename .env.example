# Puerto del servidor NestJS
PORT=3000

# Host y puerto del servicio YOLO (cambiar a "yolo" si usas Docker)
YOLO_HOST=localhost
YOLO_PORT=8000

# Firebase Admin SDK (descargar clave de servicio desde Firebase Console)
# Opción 1: Ruta al archivo JSON de la cuenta de servicio
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Opción 2: Usar Application Default Credentials (requiere configurar GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_DATABASE_URL=https://ecocycle-e9c04-default-rtdb.firebaseio.com
