FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias del sistema necesarias para OpenCV
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Instalar librerías de Python necesarias
RUN pip install --no-cache-dir ultralytics Pillow

# Copiar el archivo del servicio YOLO
COPY yolo_service.py .

# Predescargar el modelo durante la construcción de la imagen
# Esto evita descargas lentas e inestables al iniciar el contenedor
RUN python3 -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"

EXPOSE 8000

ENV YOLO_PORT=8000
ENV YOLO_MODEL_PATH=yolov8n.pt

CMD ["python3", "yolo_service.py"]
