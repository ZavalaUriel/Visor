FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir ultralytics Pillow

COPY yolo_service.py .

RUN python3 -c "from ultralytics import YOLO; YOLO('yolo11n.pt')"

EXPOSE 8000

ENV YOLO_PORT=8000
ENV YOLO_MODEL_PATH=yolo11n.pt

CMD ["python3", "yolo_service.py"]
